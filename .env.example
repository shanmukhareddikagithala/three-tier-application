# ==========================================
# Application Environment Configuration
# ==========================================
# Copy this file to '.env' and populate with your credentials.
# Do NOT commit '.env' to version control!

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite)
# Container default path mounted to persistent docker volume
DB_PATH=/app/data/users.db

# Redis Cache & Session Store
# Inside Docker Compose network, connects to the 'redis' container service
REDIS_URL=redis://redis:6379

# JWT Secret Key
# Change this to a secure random 32+ character string in production
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_chars

# Email Configuration (Nodemailer / SMTP)
# e.g., Mailtrap Sandbox: sandbox.smtp.mailtrap.io, Port: 2525
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# Frontend Configuration (Vite)
# API URL that the browser calls to reach the backend
VITE_API_URL=http://localhost:5000
